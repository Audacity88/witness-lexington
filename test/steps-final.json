 },
 {
  "name": "essay-fail",
  "js": "WitnessGame.seek('essay',{pause:true,text:'I think the British fired first because Revere saw the smoke in front of the Troops. That is not fair.'})",
  "after": "WitnessGame.checkEssay()",
  "shot": "12-essay-failing-hints",
  "expect": "(r=>!r.passed&&r.hints.some(h=>h.includes('the British account yet'))&&!r.criteria.length.pass&&!r.criteria.evidence.pass)(WitnessGame.state().essay)"
 },
 {
  "name": "essay-clear",
  "js": "WitnessGame.setEssay('')"
 },
 {
  "name": "paste-attempt",
  "js": "(()=>{const ta=document.querySelector('.wg-ta');const dt=new DataTransfer();dt.setData('text/plain','pasted essay text');ta.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true}));return ta.value.length})()",
  "expect": "(e=>e.flags.pasteAttempted&&e.telemetry.pasteAttempts===1&&e.text==='')(WitnessGame.state().essay)"
 },
 {
  "name": "essay-type",
  "type": {
   "sel": ".wg-ta",
   "text": "I believe the British regulars fired first. Paul Revere saw the smoke in front of the Troops, and the Doolittle engraving shows the British firing. In my reenactment I picked a regular in front of the militia, and the depositions card was green. The British account from Barker's diary says the militia fired two shots first, but it is only a paraphrase and unverified, so it is weaker. It is still possible though, because a house covered the militia from Revere."
  },
  "after": "WitnessGame.checkEssay()",
  "shot": "13-essay-passing",
  "expect": "(e=>e.passed&&e.own.length>0&&e.flags.lowKeystrokeRatio===false&&e.flags.aiSuspected===null&&e.telemetry.keystrokes>300)(WitnessGame.state().essay)"
 },
 {
  "name": "pick-after",
  "js": "WitnessGame.seek('pick',{pause:true})",
  "expect": "document.body.innerText.includes('evidence room')"
 },
